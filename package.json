  "main": "host.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kol-mm/dsh-config-migrate.git"
  },
  "homepage": "https://github.com/kol-mm/dsh-config-migrate#readme",
  "bugs": {
    "url": "https://github.com/kol-mm/dsh-config-migrate/issues"
  },
  "engines": {
